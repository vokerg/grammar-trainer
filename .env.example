NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
# Neon PostgreSQL connection string. Use a disposable database for tests.
DATABASE_URL=postgresql://user:password@host/database
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grammar_trainer_test

# Default provider: DeepSeek's OpenAI-compatible API.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=replace-with-your-deepseek-api-key
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=1
LLM_STORE_RAW_RESPONSE=false
LLM_DEBUG_LOGGING=false
LLM_REASONING_EFFORT=
LLM_THINKING_MODE=disabled

# Used only when LLM_PROVIDER=mock.
MOCK_LLM_MODE=success
LOG_LEVEL=info
VITE_API_BASE_URL=http://localhost:3001

