{
  "name": "grammar-trainer",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm build && pnpm --parallel --filter @grammar/api --filter @grammar/web dev",
    "dev:deepseek": "pnpm dev",
    "dev:qwen": "pnpm build && pnpm --parallel --filter @grammar/api --filter @grammar/web dev:qwen",
    "build": "pnpm -r build",
    "test": "pnpm build && pnpm -r test",
    "lint": "pnpm build && pnpm -r lint",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@eslint/js": "9.20.0",
    "@prisma/client": "6.4.1",
    "@types/node": "22.13.4",
    "cross-env": "^10.1.0",
    "eslint": "9.20.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.18",
    "globals": "15.15.0",
    "prettier": "3.5.1",
    "prisma": "6.4.1",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "typescript-eslint": "8.24.1"
  },
  "dependencies": {
    "pnpm": "^11.13.1"
  }
}
