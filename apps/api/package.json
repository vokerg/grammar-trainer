{
  "name": "@grammar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "dev:deepseek": "LLM_REASONING_EFFORT= tsx watch --env-file=../../.env.deepseek src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/src/server.js",
    "start:deepseek": "LLM_REASONING_EFFORT= node --env-file=../../.env.deepseek dist/src/server.js",
    "test": "vitest run",
    "lint": "eslint src tests --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.0.0",
    "@grammar/config": "workspace:*",
    "@grammar/llm": "workspace:*",
    "@grammar/shared": "workspace:*",
    "@prisma/client": "6.4.1",
    "fastify": "5.2.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "vitest": "3.0.6"
  }
}
