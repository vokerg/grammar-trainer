{
  "name": "@grammar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "eslint src tests --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.0.0",
    "@grammar/config": "workspace:*",
    "@grammar/llm": "workspace:*",
    "@grammar/shared": "workspace:*",
    "@prisma/client": "6.4.1",
    "fastify": "5.2.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "vitest": "3.0.6"
  }
}
